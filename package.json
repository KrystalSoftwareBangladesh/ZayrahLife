{
  "name": "zayrah-life-ecommerce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5000",
    "dev:staging": "vite --host 0.0.0.0 --port 5000 --mode staging",
    "dev:prod": "vite --host 0.0.0.0 --port 5000 --mode production",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint src --ext .vue,.js,.jsx,.ts,.tsx,.cjs,.mjs --max-warnings 0",
    "lint:fix": "eslint src --ext .vue,.js,.jsx,.ts,.tsx,.cjs,.mjs --fix",
    "type-check": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.10",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "pinia": "^2.1.7",
    "typescript": "^5.9.3",
    "vue": "^3.4.21",
    "vue-eslint-parser": "^10.2.0",
    "vue-router": "^4.3.0",
    "vue-tsc": "^3.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.8"
  }
}
